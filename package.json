{
  "name": "b-atlas-public",
  "private": true,
  "version": "6.85.0",
  "description": "B-Atlas boat knowledge, research, search and community contribution platform",
  "scripts": {
    "test:marketplace-signal": "node developer/test-marketplace-signal.js",
    "validate:marketplaces": "node developer/validate-marketplace-signals.js",
