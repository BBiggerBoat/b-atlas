  "identityDecisions": [
    {
      "scope": "30 Scarab Sport generations",
      "decision": "distinct_generations",
      "models": [
        "WELL-30-SCARAB-7993",
        "WELL-302-SCARAB",
        "WELL-30-SCARAB-0810"
      ],
      "rationale": "Separated by long production gaps and materially different beam, weight, tankage and deck layouts."
    },
    {
      "scope": "32 Scarab Sport / 32 CCF",
      "decision": "one_rename_chain_identity",
      "models": [
        "WELL-32-SCARAB-CCF"
      ],
      "rationale": "HMY states 32 Scarab Sport in 2001–04 and 32 CCF in 2005–06."
    },
    {
      "scope": "310 Suncruiser / 3100 Express",
      "decision": "one_rename_chain_identity",
      "models": [
        "WELL-310-SUN-3100-EX"
      ],
      "rationale": "Cataloged by HMY as one continuous 1979–85 identity."
    },
    {
      "scope": "3200 Coastal versus 3200 Sedan Bridge",
      "decision": "distinct_layout_identities",
      "models": [
        "WELL-3200-COASTAL",
        "WELL-3200-SB"
      ],
      "rationale": "Same basic platform, but HMY describes the Sport/Sedan Bridge version as a flybridge/enclosed-salon derivative; retained separately under B-Atlas layout policy."
    },
    {
      "scope": "3400 Express / Gran Sport",
      "decision": "one_continuous_identity",
      "models": [
        "WELL-3400-EX-GS"
      ],
      "rationale": "HMY catalogs the names together as one continuous 1984–92 family."
    },
    {
      "scope": "Triumph Express versus Triumph Sedan",
      "decision": "distinct_layout_identities",
      "models": [
        "WELL-34-TRI-EX",
        "WELL-34-TRI-SED"
      ],
      "rationale": "Same underlying dimensions but materially different express versus sedan superstructures and marketed products."
    }
  ],
  "sizePolicy": "Hard maximum published overall length remains 50.0 ft."
