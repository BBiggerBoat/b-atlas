    },
    {
      "scope": "R35 2014–21 versus R35 2024–current",
      "decision": "distinct_generations",
      "models": [
        "COBA-R35-24"
      ],
      "rationale": "Current R35 has materially different published dimensions, 165-gallon fuel capacity and new current-generation features; Cobalt's owner archive separates 2019–22 R35 documentation from 2024-on R35 manuals."
    },
    {
      "scope": "R35 versus R35 Coastal",
      "decision": "distinct_propulsion_identities",
      "models": [
        "COBA-R35-24",
        "COBA-R35-COASTAL"
      ],
      "rationale": "Current R35 is sterndrive with 165 gallons fuel; R35 Coastal is outboard with 250 gallons fuel and materially different transom/propulsion architecture."
    },
