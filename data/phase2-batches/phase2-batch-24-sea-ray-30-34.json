    {
      "scope": "300 Sundancer",
      "decision": "four linked generations",
      "models": [
        "SRAY-300-SD-G1",
        "SRAY-300-SD-G2",
        "SRAY-300-SD-G3",
        "SRAY-300-SD-G4"
      ],
      "rationale": "Discontinuous production and materially different overall length, beam, displacement and tankage justify separate generations."
    },
    {
      "scope": "300 Weekender",
      "decision": "two linked generations",
      "models": [
        "SRAY-300-WE-G1",
        "SRAY-300-WE-G2"
      ],
      "rationale": "Separate 1975–81 and 1985–89 runs have materially different hull dimensions and tankage."
    },
    {
      "scope": "310 Sundancer",
      "decision": "two linked generations plus separately marketed 310/330 lineage",
      "models": [
        "SRAY-310-SD-G1",
        "SRAY-310-SD-G2",
        "SRAY-310-330-SD-G1",
