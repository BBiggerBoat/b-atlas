        "SRAY-SRV310-SD"
      ],
      "rationale": "Sea Ray repeatedly reused 310/330 naming across distinct hull generations; combined-name source records are retained where the model was renamed during a continuous production identity."
    },
    {
      "scope": "320 Sundancer",
      "decision": "separate inboard/sterndrive generation and modern outboard variant",
      "models": [
        "SRAY-320-SD-G1",
        "SRAY-320-SD-G2",
        "SRAY-320-SD-OB"
      ],
      "rationale": "The 2003–07 and 2019-current generations are separated by a long gap; the Outboard is a separately marketed propulsion/layout variant."
    },
    {
      "scope": "340 Sundancer",
      "decision": "three linked generations",
      "models": [
        "SRAY-340-SD-G1",
        "SRAY-340-SD-G2",
