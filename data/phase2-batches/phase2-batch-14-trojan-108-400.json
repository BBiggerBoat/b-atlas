  "identityDecisions": [
    {
      "scope": "Trojan 11 Meter Express",
      "decision": "two_linked_generations",
      "models": [
        "TROJ-11M-EX-G1",
        "TROJ-11M-EX-G2"
      ],
      "rationale": "1990–92 retains the DeltaConic hull lineage but adds integral platform/deck changes and a completely new interior floorplan; a flat single record would hide material buyer-relevant differences."
    },
    {
      "scope": "Trojan 350/360 Express",
      "decision": "single_canonical_model_with_name_and_layout_phase",
      "rationale": "350 became 360 in 1999–2001 while cockpit and basic floorplan remained substantially continuous; 1999 seating change is a production-phase update."
    },
    {
      "scope": "Trojan 370/390/400 Express",
      "decision": "single_canonical_model_with_marketing_name_phases",
      "rationale": "HMY documents continuous basic cockpit/interior identity through 370, 390 and 400 names; 1995 platform change affects overall length but not core model identity."
    },
    {
      "scope": "10.8 Meter Express to 370 Express lineage",
      "decision": "linked_successor_identity",
      "rationale": "HMY states the 1991–92 10.8 Meter Express was reintroduced in 1993 as the 370 Express; retain separate production identities linked by lineage because ownership era, model naming and published hull specifications differ."
    }
