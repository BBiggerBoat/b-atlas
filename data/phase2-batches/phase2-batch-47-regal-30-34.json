  "identityDecisions": [
    {
      "scope": "Ventura 9.8 / 322 / 3260 Commodore",
      "decision": "one_rename_chain_identity",
      "models": [
        "REGL-V98-322-3260"
      ],
      "rationale": "HMY documents Ventura 9.8 in 1993–94, 322 Commodore in 1995–99, and 3260 Commodore thereafter on the same long-running platform."
    },
    {
      "scope": "32 / 33 Express",
      "decision": "one_rename_chain_identity",
      "models": [
        "REGL-32-33-EX"
      ],
      "rationale": "HMY states the 33 Express was called the 32 Express before 2018; manufacturer owner-manual drawings dated 2013 support the earlier 32 Express phase."
    },
    {
      "scope": "3300 Bowrider versus 33 OBX",
      "decision": "two_distinct_propulsion_identities",
      "models": [
        "REGL-3300-BR",
        "REGL-33-OBX"
      ],
      "rationale": "33 OBX is the outboard version of the sterndrive 3300; materially different propulsion/transom configuration warrants separate marketed identities."
    },
    {
      "scope": "33 Express versus 33 XO",
      "decision": "two_distinct_propulsion_identities",
      "models": [
        "REGL-32-33-EX",
        "REGL-33-XO"
      ],
      "rationale": "33 XO is the outboard-powered sistership of the sterndrive Express; retain separate identities."
    },
    {
      "scope": "3350 Sport Cruiser versus 3360 Window Express",
      "decision": "two_distinct_layout_identities",
      "models": [
        "REGL-3350-SC",
        "REGL-3360-WE"
      ],
      "rationale": "Similar dimensions and years but materially different deck/cabin concepts and marketed names."
    }
  ],
