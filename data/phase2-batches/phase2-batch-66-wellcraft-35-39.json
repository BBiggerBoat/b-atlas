  "identityDecisions": [
    {
      "scope": "35 Scarab Sport cuddy versus 35 Scarab Sport / 35 CCF",
      "decision": "distinct_layout_and_hull_identities",
      "models": [
        "WELL-35-SCARAB-CUDDY",
        "WELL-35-SCARAB-CCF"
      ],
      "rationale": "HMY catalogs two concurrent 35-foot Scarab products with different overall length, fuel/water capacity and cuddy versus open-center-console arrangements."
    },
    {
      "scope": "352 Tournament / 35 Scarab Tournament",
      "decision": "one_rename_chain_identity",
      "models": [
        "WELL-35-SCARAB-TOUR"
      ],
      "rationale": "HMY states the 35 Scarab Tournament was introduced as the 352 Tournament in 2006."
    },
    {
      "scope": "3500 Corsair / 3600 St. Tropez",
      "decision": "one_rename_chain_identity",
      "models": [
        "WELL-3500-COR-3600-STT"
      ],
      "rationale": "HMY states it launched as 3500 Corsair in 1992 and was renamed 3600 St. Tropez in 1993."
    },
    {
      "scope": "3500 Corsair / 3600 St. Tropez versus 3600 Martinique",
      "decision": "distinct_successor_generation",
      "models": [
        "WELL-3500-COR-3600-STT",
        "WELL-3600-MART"
      ],
      "rationale": "HMY explicitly describes the 3600 Martinique as an updated successor with new floorplan and redesigned cockpit; separate canonical identity retained."
    },
    {
      "scope": "3700 Corsica versus 3700 Cozumel",
      "decision": "distinct_layout_identities",
      "models": [
        "WELL-3700-CORSICA",
        "WELL-3700-COZUMEL"
      ],
      "rationale": "Same broad size class but mid-cabin express cruiser versus convertible sportfisher with flybridge and materially different mission."
    },
    {
      "scope": "390 Coastal",
      "decision": "include_nominal_39_with_long_overall",
      "models": [
        "WELL-390-COASTAL"
      ],
      "rationale": "Nominal 390 belongs in this batch; published overall length with pulpit is 44'7\", still within the 50'0\" project cap."
    }
  ],
  "sourceNotes": [
    {
