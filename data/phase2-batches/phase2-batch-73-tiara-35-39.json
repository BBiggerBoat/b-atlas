  "identityDecisions": [
    {
      "scope": "3600 Open generations",
      "decision": "two_distinct_generations",
      "models": [
        "TIAR-3600-OPEN-8596",
        "TIAR-3600-OPEN-0514"
      ],
      "rationale": "Eight-year production gap plus materially different dimensions, deadrise, displacement and propulsion era; retain as distinct generation identities."
    },
    {
      "scope": "3600 Convertible versus original 3600 Open",
      "decision": "distinct_layout_identities",
      "models": [
        "TIAR-3600-CVT",
        "TIAR-3600-OPEN-8596"
      ],
      "rationale": "Shared hull does not override materially distinct flybridge-sedan versus open/express marketed layouts."
    },
    {
      "scope": "3900 family",
      "decision": "distinct_layout_identities",
      "models": [
        "TIAR-3900-CVT",
        "TIAR-3900-CORONET",
        "TIAR-3900-OPEN",
        "TIAR-3900-SOVRAN"
      ],
      "rationale": "Convertible, Coronet, Open and Sovran are materially different marketed products and propulsion/layout concepts; do not collapse by nominal length."
